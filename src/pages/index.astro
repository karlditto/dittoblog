import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import Background from '../components/Background.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
    <Background />
		<Header />
		<main>
			<h1> Hello, Welcome!</h1>
      <img src="/Ditto.png" alt="I'am Ditto"> 
		</main>
		<Footer />
	</body>
</html>
